# GitHub Configuration (REQUIRED)
GITHUB_TOKEN=

# GitHub Account (optional, defaults to ALANDVO)
GH_USER=ALANDVO

# Commit Author Email (optional, defaults to alanvo@gmail.com)
EMAIL=alanvo@gmail.com

# Local Build Directory (optional, defaults to ~/ai-factory/repos)
BASE=~/ai-factory/repos

# Log File Path (optional, defaults to ~/ai-factory/pushed.log)
LOG=~/ai-factory/pushed.log

# State File Path (optional, defaults to ~/ai-factory/state.json)
STATE=~/ai-factory/state.json

# LLM Configuration (optional, used by generated apps)
# LLM_API_KEY=your-llm-api-key
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o